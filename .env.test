# Carregado por `npm test` (node --env-file-if-exists=.env.test) antes do .env.
# Não guarde segredos aqui: este arquivo é versionado.
# Os testes usam o banco "<POSTGRES_DB>_test" e o banco 1 do Redis, derivados de
# DATABASE_URL e REDIS_URL do .env (ou TEST_DATABASE_URL / TEST_REDIS_URL, se definidas).
NODE_ENV=test
LOG_LEVEL=silent
RATE_LIMIT_STORE=memory
RATE_LIMIT_LOGIN_MAX=10000
RATE_LIMIT_REGISTER_MAX=10000
RATE_LIMIT_CICLO_MANUAL_MAX=10000
INTERVALO_MINIMO_SEGUNDOS=1
