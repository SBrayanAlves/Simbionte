# Servidor
PORT=3000
NODE_ENV=development

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# Postgres (usados pelo docker-compose e pelo Prisma)
POSTGRES_USER=simbionte
POSTGRES_PASSWORD=simbionte
POSTGRES_DB=simbionte
# Nota: a porta 55432 (em vez da 5432 padrão) evita conflito com instâncias
# nativas do PostgreSQL que já estejam rodando na máquina host.
DATABASE_URL=postgresql://simbionte:simbionte@localhost:55432/simbionte

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_USER=simbionte
RABBITMQ_PASSWORD=simbionte
RABBITMQ_URL=amqp://simbionte:simbionte@localhost:5672

# Auth
# Gere um segredo forte, ex.: openssl rand -hex 32
JWT_ACCESS_SECRET=troque-este-segredo-em-producao
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
