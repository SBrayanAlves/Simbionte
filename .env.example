# Copie para .env com `npm run setup`: o script troca cada "troque-me-*" e o JWT_ACCESS_SECRET
# vazio por valores aleatórios. Se copiar à mão, troque TODOS os placeholders.

# Servidor
PORT=3000
NODE_ENV=development
# Saltos de proxy reverso confiáveis (0 = nenhum). Ex.: 1 atrás de um Nginx/Traefik.
TRUST_PROXY=0
# Nível dos logs (pino): fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
# Documentação Swagger em /docs. Padrão: ligada fora de produção, desligada em produção.
# DOCS_HABILITADO=false

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# Postgres (usados pelo docker-compose e pelo Prisma)
POSTGRES_USER=simbionte
POSTGRES_PASSWORD=troque-me-postgres
POSTGRES_DB=simbionte
# Nota: a porta 55432 (em vez da 5432 padrão) evita conflito com instâncias
# nativas do PostgreSQL que já estejam rodando na máquina host.
DATABASE_URL=postgresql://simbionte:troque-me-postgres@localhost:55432/simbionte

# Redis (com senha; o docker-compose exige REDIS_PASSWORD)
REDIS_PASSWORD=troque-me-redis
REDIS_URL=redis://:troque-me-redis@localhost:6379

# RabbitMQ
RABBITMQ_USER=simbionte
RABBITMQ_PASSWORD=troque-me-rabbitmq
RABBITMQ_URL=amqp://simbionte:troque-me-rabbitmq@localhost:5672

# Auth
# Segredo de 32+ caracteres. Gere com: openssl rand -hex 32
# (ou: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Rate limit (por IP, janela de 15 min). "redis" compartilha o contador entre instâncias.
# Padrão do store: redis em produção, memory fora dela.
# RATE_LIMIT_STORE=memory
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_REGISTER_MAX=20
RATE_LIMIT_REFRESH_MAX=60
# Execuções manuais de ciclo (POST /ciclos/executar) por usuário, por minuto.
RATE_LIMIT_CICLO_MANUAL_MAX=10

# Cotas por usuário (respondem 422 quando excedidas)
MAX_SIMULACOES_POR_USUARIO=5
MAX_AGENTES_POR_SIMULACAO=50
# Intervalo mínimo entre ciclos. Padrão: 30 em produção, 1 fora dela.
# INTERVALO_MINIMO_SEGUNDOS=30

# Orquestrador de ciclos
# Intervalo padrão entre ciclos (segundos), usado quando a simulação não define um.
CICLO_INTERVALO_PADRAO_SEGUNDOS=300
# Chamadas simultâneas ao módulo de conexão dentro de um ciclo.
DECISAO_CONCORRENCIA=5
# Tempo máximo (ms) e número de tentativas por decisão de agente.
DECISAO_TIMEOUT_MS=30000
DECISAO_TENTATIVAS=2
# Módulo de conexão com os LLMs. "stub" gera respostas simuladas, sem chamar provedor algum.
LLM_GATEWAY=stub

# Worker (npm run worker)
# A cada quantos segundos o worker procura simulações EXECUTANDO no banco.
WORKER_SINCRONIZACAO_SEGUNDOS=5
# Logs de PERCEPCAO mais antigos que isso são apagados pelo worker (0 = nunca apagar).
LOGS_PERCEPCAO_RETENCAO_DIAS=30
