{
  "name": "simbionte",
  "version": "1.0.0",
  "description": "Backend do Simbionte (Subgrupo A): autenticação, simulações e orquestrador do ciclo de agentes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "setup": "node scripts/setup-env.ts",
    "db:migrate": "prisma migrate dev",
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "worker": "node src/worker.ts",
    "worker:dev": "node --watch src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "pretest": "node --env-file-if-exists=.env.test scripts/test-db.ts",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \"tests/**/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SBrayanAlves/Simbionte.git"
  },
  "author": "Sebastiao Brayan",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/SBrayanAlves/Simbionte/issues"
  },
  "homepage": "https://github.com/SBrayanAlves/Simbionte#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "rate-limit-redis": "^4.2.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.10.1",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  }
}
